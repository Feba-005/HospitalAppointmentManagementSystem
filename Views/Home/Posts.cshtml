@model List<HospitalAppointmentManagementSystem.Models.ApiPost>

@{
    ViewData["Title"] = "Async Posts";
}

<div class="container mt-4 mb-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Remote Posts (Asynchronous Fetch)</h5>
            <span class="badge bg-success">Status: 200 OK</span>
        </div>
        <div class="card-body p-0">
            @if (ViewBag.Error != null)
            {
                <div class="p-3 text-danger">@ViewBag.Error</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover align-middle mb-0">
                        <thead class="table-primary text-dark text-center">
                            <tr style="width: 100px;">
                                <th style="width: 100px;">Post ID</th>
                                <th>Title</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var post in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold">@post.Id</td>
                                    <td class="ps-3">@post.Title</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="card-footer text-muted small">
            * Retrieved asynchronously from <code>https://jsonplaceholder.typicode.com/posts</code> using <code>HttpClient</code>.
        </div>
    </div>
</div>