@model List<HospitalAppointmentManagementSystem.Models.Doctor>

@{
    ViewData["Title"] = "Doctor Directory";
}

<div class="container mt-4 mb-5">
    @if (TempData["Message"] != null)
    {
        <!-- Alert showing confirmed booking details from TempData -->
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["Message"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-2 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Doctor Consultation Directory</h5>
            <span class="badge bg-info text-dark">IMemoryCache: 3-Min Expiry</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover align-middle mb-0 text-center">
                    <thead class="table-primary text-dark">
                        <tr>
                            <th>Doctor ID</th>
                            <th>Doctor Name</th>
                            <th>Specialization</th>
                            <th>Experience</th>
                            <th>Consultation Fee (₹)</th>
                            <th>Total Charge (+₹100 Service Fee)</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model)
                        {
                            <tr>
                                <td class="fw-bold">@doc.DoctorId</td>
                                <td class="text-start ps-3 fw-semibold">@doc.DoctorName</td>
                                <td><span class="badge bg-secondary">@doc.Specialization</span></td>
                                <td>@doc.Experience Years</td>
                                <td>₹@doc.ConsultationFee.ToString("N2")</td>
                                <!-- Calling C# Extension Method CalculateTotalCharge() -->
                                <td class="text-success fw-bold">₹@doc.CalculateTotalCharge().ToString("N2")</td>
                                <td>
                                    <!-- Query String passing doctorId to details page -->
                                    <a asp-action="Details" asp-route-doctorId="@doc.DoctorId" class="btn btn-sm btn-primary">
                                        Book / Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted small">
            * Total Charge computed using <code>CalculateTotalCharge()</code> C# Extension Method (+₹100 service charge).
        </div>
    </div>
</div>